class Solution(object):
    def searchMatrix(self, matrix, target):
        rows = len(matrix)
        cols = len(matrix[0])
        
        low = 0
        high = (rows * cols) - 1
        
        while low <= high:
            mid = (low + high) // 2
            
            row = mid // cols      # ✔ correct
            col = mid % cols       # ✔ correct
            
            middle = matrix[row][col]
            
            if middle == target:
                return True
            elif middle < target:
                low = mid + 1
            else:
                high = mid - 1
        
        return False


# ---- Driver Code ----
matrix = [[1,3,5,7],
          [10,11,16,20],
          [23,30,34,60]]

target = 3

obj = Solution()
print(obj.searchMatrix(matrix, target))   # Output: True
